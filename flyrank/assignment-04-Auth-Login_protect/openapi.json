{
  "openapi": "3.0.0",
  "info": {
    "title": "Marta's Secret Kitchen API",
    "version": "1.0.0",
    "description": "Authentication and route-protection API for restaurant staff signup, login, public storefront information, and protected staff access checks."
  },
  "servers": [
    {
      "url": "/",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/public/info": {
      "get": {
        "summary": "Public storefront information",
        "description": "Returns public restaurant information such as the business name, address, and operating hours. No authentication is required.",
        "responses": {
          "200": {
            "description": "Public information returned successfully",
            "content": {
              "application/json": {
                "example": {
                  "restaurant_name": "Marta's Secret Kitchen",
                  "operating_hours": "11:00 AM - 10:30 PM (Tue-Sun)",
                  "address": "Bladr Runner, Sector 2049",
                  "message": "Welcome! This information is public and open to everyone."
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "Register a new staff member",
        "description": "Creates a new Supabase Auth user for restaurant staff. Email and password are required, and optional profile metadata such as full_name and staff_role can be included.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "chef_marco@luigiskitchen.com",
                "password": "SecretPassword123!",
                "full_name": "Marco Rossi",
                "staff_role": "Head Chef"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Staff member registered successfully",
            "content": {
              "application/json": {
                "example": {
                  "message": "Staff registered successfully",
                  "user": {
                    "id": "8e8d7f2d-4b19-4b2d-95ab-1d4dbd8e91db",
                    "email": "chef_marco@luigiskitchen.com",
                    "created_at": "2026-08-14T10:20:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - missing email or password",
            "content": {
              "application/json": {
                "example": {
                  "error": "Email and password are required"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate a staff member",
        "description": "Logs in an existing staff account and returns the Supabase session tokens needed for protected routes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "chef_marco@luigiskitchen.com",
                "password": "SecretPassword123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "example": {
                  "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "refresh_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "token_type": "bearer",
                  "expires_in": 3600,
                  "user": {
                    "id": "8e8d7f2d-4b19-4b2d-95ab-1d4dbd8e91db",
                    "email": "chef_marco@luigiskitchen.com"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - missing email or password",
            "content": {
              "application/json": {
                "example": {
                  "error": "Email and password are required"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid login credentials",
            "content": {
              "application/json": {
                "example": {
                  "error": "Invalid login credentials"
                }
              }
            }
          }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "summary": "Protected staff profile endpoint",
        "description": "Validates that the request includes a Bearer token in the Authorization header and verifies that token against Supabase before returning the authenticated staff profile.",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
            },
            "description": "Bearer token used to prove the caller is a valid, authenticated staff member"
          }
        ],
        "responses": {
          "200": {
            "description": "Token verified successfully; authenticated user profile returned",
            "content": {
              "application/json": {
                "example": {
                  "message": "Staff identity verified successfully",
                  "user": {
                    "id": "2b2b4fea-4c7e-4a28-b490-4aa421cfa699",
                    "email": "ahteshamlatif22@gmail.com",
                    "metadata": {
                      "email_verified": true,
                      "provider": "email"
                    },
                    "last_sign_in_at": "2026-08-14T18:67:35.000Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing, malformed, invalid, or expired Authorization token",
            "content": {
              "application/json": {
                "example": {
                  "error": "Invalid or expired access token"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "summary": "Health/status route",
        "description": "Returns a simple message confirming the stats route is active and provides the available endpoints for this project.",
        "responses": {
          "200": {
            "description": "Status lookup successful",
            "content": {
              "application/json": {
                "example": {
                  "message": "Stats route is working!",
                  "Endpoints are": [
                    "/",
                    "/docs",
                    "/public/info",
                    "/auth/signup",
                    "/auth/login",
                    "/protected/profile"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
